    </model>

    <model name="left_wall">
      <static>true</static>
      <pose>13.5 1.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>33 0.2 2.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Realistic wall friction; end-effector has mu=0.02 so effective contact = min(0.02, 0.5) = 0.02 -->
                <mu>0.5</mu>
                <mu2>0.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>33 0.2 2.5</size>
