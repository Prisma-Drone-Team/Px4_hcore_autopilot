        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <include merge='true'>
      <uri>model://OakD-Lite</uri>
      <pose>0.2 0.0 -0.03 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>OakD-Lite/base_link</child>
      <pose relative_to="base_link">0.2 0.0 -0.03 0 0 0</pose>
    </joint>

    <include>
      <uri>model://tactile_stick</uri>
      <name>tactile_stick_left</name>
      <pose>0 0.1 -0.1 -1.5708 0 0</pose>
    </include>
    <joint name="joint_stick_left" type="fixed">
      <parent>base_link</parent>
      <child>tactile_stick_left::end_eff</child>
    </joint>

    <include>
      <uri>model://tactile_stick</uri>
      <name>tactile_stick_right</name>
      <pose>0 -0.1 -0.1 1.5708 0 0</pose>
    </include>
    <joint name="joint_stick_right" type="fixed">
      <parent>base_link</parent>
      <child>tactile_stick_right::end_eff</child>
    </joint>

