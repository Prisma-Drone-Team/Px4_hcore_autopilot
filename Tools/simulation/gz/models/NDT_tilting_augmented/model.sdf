<!-- Joints per collegare i link al base_link -->
<joint name="sens_joint_front_top" type="fixed">
    <pose>0.0 0.0 0.0 0 0 0</pose>
    <child>sensor_mount_front_top</child>
    <parent>base_link</parent>
</joint>

<joint name="sens_joint_front_bottom" type="fixed">
    <pose>0.0 0.0 0.0 0 0 0</pose>
    <child>sensor_mount_front_bottom</child>
    <parent>base_link</parent>
</joint>

<joint name="sens_joint_front_left" type="fixed">
    <pose>0.0 0.0 0.0 0 0 0</pose>
    <child>sensor_mount_front_left</child>
    <parent>base_link</parent>
</joint>

<joint name="sens_joint_front_right" type="fixed">
    <pose>0.0 0.0 0.0 0 0 0</pose>
    <child>sensor_mount_front_right</child>
    <parent>base_link</parent>
</joint>

