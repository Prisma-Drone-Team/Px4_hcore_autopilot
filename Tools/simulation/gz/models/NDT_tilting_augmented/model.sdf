<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name="NDT_tilting_augmented">
    <include merge="true">
      <uri>model://NDT_tilting_interaction</uri>
    </include>

    <!-- Additional range sensors for orientation estimation -->
    <!-- Front Upper LIDAR Sensor Link -->
<link name="sensor_mount_front_top">
    <pose>0.0 -0.1 0.15 0 0 0</pose>
    <inertial>
        <mass>0.0125</mass>
        <inertia>
            <ixx>0.000025</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000025</iyy>
            <iyz>0</iyz>
            <izz>0.000025</izz>
        </inertia>
    </inertial>

    <visual name="visual">
        <geometry>
            <box>
                <size>0.03 0.03 0.03</size>
            </box>
        </geometry>
        <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <emissive>1 0 0 1</emissive>
        </material>
    </visual>

    <collision name="collision">
        <geometry>
            <box>
                <size>0.03 0.03 0.03</size>
            </box>
        </geometry>
    </collision>

    <sensor name='lidar_front_top' type='gpu_lidar'>
        <pose relative_to='sensor_mount_front_top'>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-0.0174533</min_angle>
                    <max_angle>0.0174533</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.001</min>
                <max>2.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
    </sensor>
</link>

<!-- Front Lower LIDAR Sensor Link (VERDE) -->
<link name="sensor_mount_front_bottom">
    <pose>0.0 0.1 -0.25 0 0 0</pose>
    <inertial>
        <mass>0.0125</mass>
        <inertia>
            <ixx>0.000025</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000025</iyy>
            <iyz>0</iyz>
            <izz>0.000025</izz>
        </inertia>
    </inertial>

    <visual name="visual">
        <geometry>
            <box>
                <size>0.03 0.03 0.03</size>
            </box>
        </geometry>
        <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <emissive>0 1 0 1</emissive>
        </material>
    </visual>

    <collision name="collision">
        <geometry>
            <box>
                <size>0.03 0.03 0.03</size>
            </box>
        </geometry>
    </collision>

    <sensor name='lidar_front_bottom' type='gpu_lidar'>
        <pose relative_to='sensor_mount_front_bottom'>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-0.0174533</min_angle>
                    <max_angle>0.0174533</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.001</min>
                <max>2.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
    </sensor>
</link>

